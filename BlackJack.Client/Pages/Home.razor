@page "/"
@using BlackJack.Client.Components
@using BlackJack.Client.Services
@inject GameClientService GameClient
@implements IDisposable

<PageTitle>Проверка комнат BlackJack</PageTitle>

<h1>Проверка комнат</h1>

<p>
    Подключение:
    <strong>
        @(GameClient.IsConnected ? "установлено" : "не установлено")
    </strong>
</p>

<button type="button"
        class="btn btn-primary"
        disabled="@(isBusy || GameClient.IsConnected)"
        @onclick="Connect">
    Подключиться
</button>

<hr />

<div class="mb-3">
    <label for="player-name" class="form-label">
        Имя игрока
    </label>

    <input id="player-name"
           class="form-control"
           disabled="@(isBusy || GameClient.State is not null)"
           @bind="playerName" />
</div>

<button type="button"
        class="btn btn-success"
        disabled="@(!CanEnterRoom)"
        @onclick="CreateRoom">
    Создать комнату на двоих
</button>

<hr />

<div class="mb-3">
    <label for="room-code" class="form-label">
        Код существующей комнаты
    </label>

    <input id="room-code"
           class="form-control"
           disabled="@(isBusy || GameClient.State is not null)"
           @bind="roomCode" />
</div>

<button type="button"
        class="btn btn-secondary"
        disabled="@(!CanEnterRoom)"
        @onclick="JoinRoom">
    Войти в комнату
</button>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger mt-3" role="alert">
        @error
    </div>
}

@if (!string.IsNullOrWhiteSpace(GameClient.Warning))
{
    <div class="alert alert-warning mt-3" role="alert">
        @GameClient.Warning
    </div>
}

@if (!string.IsNullOrWhiteSpace(GameClient.Message))
{
    <div class="alert alert-info mt-3" role="status">
        @GameClient.Message
    </div>
}

@if (GameClient.State is { } state)
{
    <div class="mt-4">
        <GameTable State="state" />
    </div>
}

@code {
    private string playerName = string.Empty;
    private string roomCode = string.Empty;
    private string? error;
    private bool isBusy;

    // разрешаем вход, пока игрок ещё не находится в комнате
    private bool CanEnterRoom =>
        !isBusy &&
        GameClient.IsConnected &&
        GameClient.State is null;

    protected override void OnInitialized()
    {
        // подписываем страницу на изменения сервиса
        GameClient.Changed += OnGameChanged;
    }

    private void OnGameChanged()
    {
        // обновляем интерфейс после сообщения сервера
        _ = InvokeAsync(StateHasChanged);
    }

    private Task Connect()
    {
        return RunAsync(GameClient.ConnectAsync);
    }

    private Task CreateRoom()
    {
        return RunAsync(
            () => GameClient.CreateRoomAsync(playerName, 2));
    }

    private Task JoinRoom()
    {
        return RunAsync(
            () => GameClient.JoinRoomAsync(roomCode, playerName));
    }

    private async Task RunAsync(Func<Task> action)
    {
        // не допускаем повторных нажатий во время запроса
        isBusy = true;
        error = null;

        try
        {
            await action();
        }
        catch (Exception exception)
        {
            Console.Error.WriteLine(exception);

            error = "Не удалось выполнить запрос. " +
                    "Проверь запуск сервера и соединение.";
        }
        finally
        {
            isBusy = false;
        }
    }

    public void Dispose()
    {
        // убираем подписку при уходе со страницы
        GameClient.Changed -= OnGameChanged;
    }
}