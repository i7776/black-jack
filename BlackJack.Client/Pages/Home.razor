@page "/"
@using BlackJack.Client.Components
@using BlackJack.Client.Services
@inject GameClientService GameClient
@implements IDisposable

<PageTitle>Boss Club · Blackjack</PageTitle>

<div class="lobby-wrapper">
    @if (GameClient.State is null)
    {
        <!-- ЭКРАН ВХОДА И СОЗДАНИЯ КОМНАТЫ -->
        <main class="login-card">
            <div class="login-header">
                <span class="gold-spade">♠</span>
                <h2>ROYAL BLACKJACK</h2>
                <p>Эксклюзивный онлайн-клуб на SignalR</p>
            </div>

            <div class="login-body">
                <!-- Статус соединения -->
                <div class="conn-bar">
                    <span class="status-indicator @(GameClient.IsConnected ? "online" : "offline")"></span>
                    <span>@(GameClient.IsConnected ? "Подключено к серверу" : "Оффлайн")</span>
                    @if (!GameClient.IsConnected)
                    {
                        <button class="action-link" disabled="@isBusy" @onclick="Connect">
                            Подключиться
                        </button>
                    }
                </div>

                <div class="field-group">
                    <label>Ваш псевдоним</label>
                    <input class="custom-input" placeholder="Введите имя..." @bind="playerName" />
                </div>

                <!-- Блок создания комнаты на 2-5 человек -->
                <section class="option-panel">
                    <h4>Создать стол</h4>
                    <div class="field-group-inline">
                        <label>Количество мест (2–5):</label>
                        <div class="stepper">
                            <button type="button" @onclick="() => ChangeMaxPlayers(-1)">-</button>
                            <span class="stepper-val">@maxPlayers</span>
                            <button type="button" @onclick="() => ChangeMaxPlayers(1)">+</button>
                        </div>
                    </div>
                    <button class="btn-gold" disabled="@(!CanEnterRoom)" @onclick="CreateRoom">
                        Создать приватный стол
                    </button>
                </section>

                <div class="or-separator"><span>ИЛИ</span></div>

                <!-- Блок входа по коду -->
                <section class="option-panel">
                    <h4>Присоединиться к столу</h4>
                    <input class="custom-input uppercase"
                           placeholder="КОД ИЗ 6 СИМВОЛОВ"
                           maxlength="6"
                           @bind="roomCode" />
                    <button class="btn-green" disabled="@(!CanEnterRoom)" @onclick="JoinRoom">
                        Войти в игру
                    </button>
                </section>
            </div>
        </main>
    }
    else
    {
        <!-- ЭКРАН ИГРЫ -->
        <div class="table-view">
            <!-- Верхняя плашка управления -->
            <div class="top-nav-bar">
                <div class="room-pill">
                    <span class="room-label">СТОЛ:</span>
                    <strong class="room-code">@GameClient.RoomId</strong>
                </div>

                <button class="btn-leave" disabled="@isBusy" @onclick="Leave">
                    <i class="bi bi-door-open me-1"></i> Выйти из-за стола
                </button>
            </div>

            <!-- Сукно стола с картами и игроками -->
            <GameTable State="GameClient.State" />

            <!-- ПЛАВАЮЩАЯ ПАНЕЛЬ ДЕЙСТВИЙ (Активна строго в свой ход!) -->
            <nav class="action-dock @(GameClient.IsMyTurn ? "dock-active" : "dock-disabled")">
                <div class="dock-content">
                    <button type="button"
                            class="action-btn btn-hit"
                            disabled="@(isBusy || !GameClient.IsMyTurn)"
                            @onclick="() => RunAsync(GameClient.HitAsync)">
                        <span class="btn-icon">➕</span> Взять карту
                    </button>

                    <button type="button"
                            class="action-btn btn-stand"
                            disabled="@(isBusy || !GameClient.IsMyTurn)"
                            @onclick="() => RunAsync(GameClient.StandAsync)">
                        <span class="btn-icon">✋</span> Хватит
                    </button>

                    <button type="button"
                            class="action-btn btn-surrender"
                            disabled="@(isBusy || !GameClient.IsMyTurn)"
                            @onclick="() => RunAsync(GameClient.SurrenderAsync)">
                        <span class="btn-icon">🏳️</span> Сдаться
                    </button>
                </div>
            </nav>
        </div>
    }

    <!-- Всплывающие уведомления -->
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="toast-alert alert-error">@error</div>
    }
    @if (!string.IsNullOrWhiteSpace(GameClient.Warning))
    {
        <div class="toast-alert alert-warning">@GameClient.Warning</div>
    }
    @if (!string.IsNullOrWhiteSpace(GameClient.Message))
    {
        <div class="toast-alert alert-info">@GameClient.Message</div>
    }
</div>

@code {
    private string playerName = string.Empty;
    private string roomCode = string.Empty;
    private int maxPlayers = 2;
    private string? error;
    private bool isBusy;

    private bool CanEnterRoom =>
        !isBusy &&
        GameClient.IsConnected &&
        GameClient.State is null &&
        !string.IsNullOrWhiteSpace(playerName);

    protected override void OnInitialized()
    {
        GameClient.Changed += OnGameChanged;
    }

    private void OnGameChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void ChangeMaxPlayers(int delta)
    {
        maxPlayers = Math.Clamp(maxPlayers + delta, 2, 5);
    }

    private Task Connect() => RunAsync(GameClient.ConnectAsync);

    private Task CreateRoom() => RunAsync(() => GameClient.CreateRoomAsync(playerName, maxPlayers));

    private Task JoinRoom() => RunAsync(() => GameClient.JoinRoomAsync(roomCode, playerName));

    private Task Leave() => RunAsync(GameClient.LeaveRoomAsync);

    private async Task RunAsync(Func<Task> action)
    {
        isBusy = true;
        error = null;
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    public void Dispose()
    {
        GameClient.Changed -= OnGameChanged;
    }
}