@using BlackJack.Shared
@using BlackJack.Client.Services
@inject GameClientService GameClient

<section class="casino-felt">
    <header class="table-header">
        <div class="casino-brand">
            <span class="suit-icon" aria-hidden="true">♠</span>
            <div class="brand-text">
                <strong>ROYAL BOSS CLUB</strong>
                <small>VIP BLACKJACK LOUNGE</small>
            </div>
        </div>

        <div class="header-controls">
            @if (GameClient.CanStartGame)
            {
                <button class="btn-start-early pulse" @onclick="GameClient.StartGameAsync">
                    ▶ Раздать карты (@State.Players.Count игр.)
                </button>
            }

            <div class="phase-badge @State.GameStatus.ToString().ToLowerInvariant()" role="status">
                <span class="pulse-dot"></span>
                @PhaseText
            </div>
        </div>
    </header>

    <div class="felt-surface">
        <section class="dealer-zone">
            <div class="zone-header">
                <span class="crown">🃁🂡🂱🃑</span>
                <span class="zone-title">ДИЛЕР КАЗИНО</span>
                @if (State.DealerCards.Count > 0)
                {
                    <span class="score-pill">@State.DealerScore очк.</span>
                }
            </div>

            <div class="card-fan dealer-fan">
                @if (State.DealerCards.Count > 0)
                {
                    @foreach (var (card, index) in State.DealerCards.Select((c, i) => (c, i)))
                    {
                        <div class="card-wrapper" style="--card-index: @index;">
                            <img class="card-img dealer-card" src="@CardImage(card)" alt="@CardDescription(card)" draggable="false" />
                        </div>
                    }
                }
                else
                {
                    <div class="waiting-box">Ожидание начала раунда...</div>
                }
            </div>
        </section>

        <!-- Водяной знак сукна -->
        <div class="table-centerpiece">
            <div class="suits-row">♣ ♦ ♠ ♥</div>
            <div class="rules-mark">˗ˋˏ⛀⛁ ⛁⛀ˎˊ˗ · BLACKJACK PAYS 3 TO 2 · ˗ˋˏ⛀⛁ ⛁⛀ˎˊ˗</div>
            @if (!string.IsNullOrEmpty(State.Message))
            {
                <div class="game-announcement">@State.Message</div>
            }
        </div>

        <!-- 2. ДРУГИЕ ИГРОКИ (Соперники сверху) -->
        @{
            var rivals = State.Players.Where(p => p.PlayerId != GameClient.ConnectionId).ToList();
            var myPlayer = State.Players.FirstOrDefault(p => p.PlayerId == GameClient.ConnectionId);
        }

        @if (rivals.Count > 0)
        {
            <div class="rivals-row">
                @foreach (var rival in rivals)
                {
                    var isRivalTurn = State.GameStatus == GameStatus.PlayersTurns &&
                                      State.Players.IndexOf(rival) == State.CurrentPlayerIndex;

                    <div class="rival-seat @(isRivalTurn ? "rival-active" : "")">
                        <div class="seat-top">
                            <span class="player-name">
                                @if (rival.IsHost)
                                {
                                    <span title="Хост стола"> ♕ </span>
                                }
                                @rival.Name
                            </span>
                            @if (rival.Score > 0 && State.GameStatus == GameStatus.Finished)
                            {
                                <span class="score-pill small">@rival.Score</span>
                            }
                        </div>

                        <span class="status-label">@(isRivalTurn ? "Ходит..." : StatusText(rival))</span>

                        <div class="card-fan compact-fan">
                            @foreach (var (card, index) in rival.Cards.Select((c, i) => (c, i)))
                            {
                                <div class="card-wrapper" style="--card-index: @index;">
                                    <img class="card-img mini-card" src="@CardImage(card)" draggable="false" />
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <!-- 3. ТЫ (ПО ЦЕНТРУ ВНИЗУ: КНОПКИ СЛЕВА, КАРТЫ В ЦЕНТРЕ) -->
        @if (myPlayer != null)
        {
            var isMyTurn = State.GameStatus == GameStatus.PlayersTurns &&
                           State.Players.IndexOf(myPlayer) == State.CurrentPlayerIndex;

            <section class="my-seat @(isMyTurn ? "my-turn" : "")">
                <div class="my-seat-header">
                    <div class="my-badge">
                        <span class="avatar">♠</span>
                        <strong>@myPlayer.Name (ВЫ)</strong>
                        @if (myPlayer.IsHost)
                        {
                            <span class="host-tag">Сoздатель комнаты</span>
                        }
                    </div>

                    <div class="my-score-display">
                        <span class="label">СЧЁТ:</span>
                        <span class="score-pill big">@myPlayer.Score очк.</span>
                    </div>

                    <div class="my-status-box">
                        <span class="status-pill status-@myPlayer.Status.ToString().ToLowerInvariant()">
                            @(isMyTurn ? "ВАШ ХОД!" : StatusText(myPlayer))
                        </span>
                    </div>
                </div>

                <!-- СЕТКА: Кнопки ровно СЛЕВА от твоих карт -->
                <div class="my-hand-area">
                    <div class="my-controls-left">
                        <button type="button"
                                class="casino-btn btn-hit-dark"
                                disabled="@(IsBusy || !GameClient.IsMyTurn)"
                                @onclick="() => OnHit.InvokeAsync()">
                            <span>Взять карту</span>
                        </button>

                        <button type="button"
                                class="casino-btn btn-stand-brown"
                                disabled="@(IsBusy || !GameClient.IsMyTurn)"
                                @onclick="() => OnStand.InvokeAsync()">
                            <span>Хватит</span>
                        </button>

                        <button type="button"
                                class="casino-btn btn-surrender-black"
                                disabled="@(IsBusy || !GameClient.IsMyTurn)"
                                @onclick="() => OnSurrender.InvokeAsync()">
                            <span>Сдаться</span>
                        </button>
                    </div>

                    <div class="my-cards-fan">
                        @if (myPlayer.Cards.Count > 0)
                        {
                            @foreach (var (card, index) in myPlayer.Cards.Select((c, i) => (c, i)))
                            {
                                <div class="card-wrapper my-card" style="--card-index: @index;">
                                    <img class="card-img main-card" src="@CardImage(card)" alt="@CardDescription(card)" draggable="false" />
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-hand">Ожидайте раздачи карт...</div>
                        }
                    </div>
                </div>
            </section>
        }
    </div>

    @if (State.GameStatus == GameStatus.Finished)
    {
        var me = State.Players.FirstOrDefault(p => p.PlayerId == GameClient.ConnectionId);

        <div class="round-modal-overlay">
            <div class="round-modal">

                @if (me != null)
                {
                    @if (me.Status == PlayerStatus.BlackJack)
                    {
                        <h2 class="hero-result hero-win">$$$ БЛЭКДЖЕК! ВЫ ПОБЕДИЛИ! $$$</h2>
                    }
                    else if (me.Status == PlayerStatus.Won)
                    {
                        <h2 class="hero-result hero-win">ВЫ ПОБЕДИЛИ!</h2>
                    }
                    else if (me.Status == PlayerStatus.Draw)
                    {
                        <h2 class="hero-result hero-draw">НИЧЬЯ</h2>
                    }
                    else if (me.Status == PlayerStatus.Surrender)
                    {
                        <h2 class="hero-result hero-surrender">ВЫ СДАЛИСЬ</h2>
                    }
                    else if (me.Status == PlayerStatus.Bust)
                    {
                        <h2 class="hero-result hero-loss">✘ ПЕРЕБОР! ВЫ ПРОИГРАЛИ ✘</h2>
                    }
                    else
                    {
                        <h2 class="hero-result hero-loss">☹ ВЫ ПРОИГРАЛИ</h2>
                    }
                }

                <!-- Итог дилера -->
                <div class="dealer-summary">
                    <span>🎲 Итог дилера:</span>
                    <strong class="@(State.DealerScore > 21 ? "text-danger-glow" : "text-gold")">
                        @State.DealerScore очк. @(State.DealerScore > 21 ? "(Перебор)" : "")
                    </strong>
                </div>

                <!-- Таблица очков и статусов ВСЕХ игроков -->
                <div class="results-board">
                    @foreach (var p in State.Players)
                    {
                        var isMe = p.PlayerId == GameClient.ConnectionId;
                        <div class="result-row @(isMe ? "result-is-me" : "")">
                            <div class="res-player">
                                @if (p.IsHost)
                                {
                                    <span>♕</span>
                                }
                                <span>@p.Name @(isMe ? "(Вы)" : "")</span>
                            </div>
                            <div class="res-score">@p.Score очк.</div>
                            <div class="res-status status-@p.Status.ToString().ToLowerInvariant()">
                                @StatusText(p)
                            </div>
                        </div>
                    }
                </div>

                <div class="modal-actions">
                    @if (GameClient.IsHost)
                    {
                        <button class="btn-gold" @onclick="GameClient.PrepareNextRoundAsync">
                            ↻ Продолжить (вернуться к столу)
                        </button>
                    }
                    else
                    {
                        <span class="waiting-host-text">Ожидание решения хоста о следующем раунде...</span>
                    }

                    <button class="btn-leave-modal" @onclick="GameClient.LeaveRoomAsync">
                        Нет, встать из-за стола
                    </button>
                </div>
            </div>
        </div>
    }

    <footer class="table-footer">
        <span>VIP CLUB CASINO · 36 КАРТ</span>
        <span>Мест занято: @State.Players.Count / @State.MaxPlayers</span>
    </footer>
</section>

@code {
    [Parameter, EditorRequired]
    public GameState State { get; set; } = new();

    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public EventCallback OnHit { get; set; }
    [Parameter] public EventCallback OnStand { get; set; }
    [Parameter] public EventCallback OnSurrender { get; set; }

    private string PhaseText => State.GameStatus switch
    {
        GameStatus.WaitingForPlayers => "Ожидание",
        GameStatus.PlayersTurns => "Ходы игроков",
        GameStatus.DealerTurns => "Ход дилера",
        GameStatus.Finished => "Итоги раунда",
        _ => "Игра"
    };

    private static string RankLabel(Rank rank) => rank switch
    {
        Rank.Jack => "J",
        Rank.Queen => "Q",
        Rank.King => "K",
        Rank.Ace => "A",
        _ => ((int)rank).ToString()
    };

    private static string SuitName(Suit suit) => suit switch
    {
        Suit.Hearts => "червей",
        Suit.Diamonds => "бубен",
        Suit.Clubs => "треф",
        Suit.Spades => "пик",
        _ => ""
    };

    private static string CardImage(Card card)
    {
        if ((int)card.Rank < 6) return "images/cards/boss/back.png";
        var rank = RankLabel(card.Rank);
        var suit = card.Suit.ToString().ToLowerInvariant();
        return $"images/cards/boss/{rank}_{suit}.png";
    }

    private static string CardDescription(Card card)
    {
        if ((int)card.Rank < 6) return "Закрытая карта";
        return $"{RankLabel(card.Rank)} {SuitName(card.Suit)}";
    }

    private static string StatusText(Player player) => player.Status switch
    {
        PlayerStatus.Waiting => "Ожидает",
        PlayerStatus.Playing => "В игре",
        PlayerStatus.Stand => "Хватит",
        PlayerStatus.Bust => "Перебор!",
        PlayerStatus.Won => "Победа!",
        PlayerStatus.Lost => "Поражение",
        PlayerStatus.Draw => "Ничья",
        PlayerStatus.BlackJack => "Блэкджек!",
        PlayerStatus.Surrender => "Сдался",
        _ => ""
    };
}